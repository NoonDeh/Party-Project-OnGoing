<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LayoutKarcis"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView
        android:id="@+id/JudulKarcis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="RINGKASAN KARCIS PARKIR"
        android:textColor="#1A237E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/KarcisNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Pengguna: -"
        android:textColor="#212121"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/KarcisKendaraan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Kendaraan: -"
        android:textColor="#212121"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/KarcisTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Total Bayar: Rp 0"
        android:textColor="#1A237E"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>