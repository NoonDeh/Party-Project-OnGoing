<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: Mengizinkan seluruh elemen layar bisa di-scroll jika dijalankan di layar HP kecil -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- LinearLayout Utama: Menyusun komponen form dari atas ke bawah secara vertikal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TextView: Judul Utama Aplikasi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Sistem Pembayaran Parkir"
            android:textColor="#6A1B9A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- MaterialCardView: Kartu wadah untuk mengelompokkan input form -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <!-- LinearLayout Di Dalam Card: Menampung elemen form input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Nama pemilik :"
                    android:textStyle="bold" />


                <!-- EditText: Input Nama Pengguna -->
                <EditText
                    android:id="@+id/InputNama"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:hint="Nama Pengguna / Pemilik"
                    android:inputType="textPersonName" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="nomor plat kendaraan :"
                    android:textStyle="bold" />


                <!-- EditText: Input Nomor Plat Kendaraan -->
                <EditText
                    android:id="@+id/InputNomorPlat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:hint="Nomor Plat Kendaraan (cth: AD 1234 AB)"
                    android:inputType="textCapCharacters" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="merk kendaraan :"
                    android:textStyle="bold" />


                <!-- EditText: Input Merk Kendaraan -->
                <EditText
                    android:id="@+id/InputMerkKendaraan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:hint="Merk Kendaraan (cth: Honda Vario)"
                    android:inputType="text" />

                <!-- TextView: Label Pilihan Jenis Kendaraan -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Pilih Jenis Kendaraan:"
                    android:textStyle="bold" />

                <!-- RadioGroup: Wadah pilihan opsi radio button (Motor / Mobil) -->
                <RadioGroup
                    android:id="@+id/JenisKendaraan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <!-- RadioButton: Pilihan Sepeda Motor -->
                    <RadioButton
                        android:id="@+id/Motor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sepeda Motor" />

                    <!-- RadioButton: Pilihan Mobil -->
                    <RadioButton
                        android:id="@+id/Mobil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Mobil" />
                </RadioGroup>

                <!-- LinearLayout Horizontal: Baris penyusun tombol counter waktu (-) dan (+) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <!-- Button: Tombol Kurangi Waktu Parkir -->
                    <Button
                        android:id="@+id/Kurang_waktu"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:onClick="Kurang_waktu"
                        android:text="-"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- EditText: Input/Display Angka Lama Parkir -->
                    <EditText
                        android:id="@+id/InputJam"
                        android:layout_width="150dp"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp"
                        android:hint="Lama Parkir (Jam, maks 36)"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textAlignment="center" />

                    <!-- Button: Tombol Tambah Waktu Parkir -->
                    <Button
                        android:id="@+id/Tambah_waktu"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:onClick="Tambah_waktu"
                        android:text="+"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Button: Tombol Eksekusi Proses Pembayaran -->
                <Button
                    android:id="@+id/Bayar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#6A1B9A"
                    android:onClick="prosesPembayaran"
                    android:text="PROSES PEMBAYARAN"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>