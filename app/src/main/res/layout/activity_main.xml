<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/judul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ap"
        android:background="@color/orange"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="25sp"
        android:textAlignment="center"
        />

    <TextView
        android:id="@+id/jenis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jk"
        android:textSize="20sp"
        android:textStyle="bold" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="99dp">

        <RadioButton
            android:id="@+id/mobil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/m"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/motor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mt"
            android:textStyle="bold" />

    </RadioGroup>

    <TextView
        android:id="@+id/cck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cc"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/icck"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:ems="10"
        android:hint="@string/c"
        android:inputType="numberSigned" />

    <TextView
        android:id="@+id/pjstnk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ps"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/ipjstnk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="numberSigned"
        android:hint="@string/p" />

    <TextView
        android:id="@+id/usk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:text="@string/uk"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/iusk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="numberSigned"
        android:hint="@string/u"/>

    <TextView
        android:id="@+id/pkbp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/pkb" />

    <TextView
        android:id="@+id/ipkbp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/swd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/sw" />

    <TextView
        android:id="@+id/iswd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/bad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bya"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/ibad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/sod"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:text="@string/sd"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/isod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/total"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:text="@string/tl"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itotal"
        android:layout_width="match_parent"
        android:layout_height="91dp" />

    <Button
        android:id="@+id/submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sub"
        android:backgroundTint="@color/grey"
        android:onClick=""/>

</LinearLayout>